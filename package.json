{
  "name": "workforce-ops-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Pages for the Workforce Operations Application (plain HTML, CSS, and JavaScript; Node.js is used only for development tools)",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . && biome lint --no-errors-on-unmatched && html-validate pages",
    "typecheck": "tsc -p jsconfig.json",
    "test": "vitest run",
    "test:integration": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.14.0",
    "html-validate": "11.19.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
