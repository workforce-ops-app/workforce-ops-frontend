{
  "name": "workforce-ops-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Pages for the Workforce Operations Application (plain HTML, CSS, and JavaScript; Node.js is used only for development tools)",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . && stylelint \"css/**/*.css\" --allow-empty-input && html-validate pages",
    "typecheck": "tsc -p jsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.12.0",
    "html-validate": "11.16.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
